// Copy this file to secrets.h in the same folder and fill in your values.
// secrets.h is gitignored — never commit it.
#pragma once

#define WIFI_SSID "your-wifi-name"
#define WIFI_PASS "your-wifi-password"

// From Pomo: Settings -> phone pairing. Rotating the token in the app
// requires reflashing with the new value.
#define POMO_TOKEN "paste-pairing-token-here"

// Optional, but it is a pin rather than a fallback: if this is non-empty the
// device uses it and does not query mDNS at all.
//
// Set it if you can. Discovery sends POMO_TOKEN to whatever answers _pomo._tcp
// first, and a token cannot verify the server it is sent to — so any device on
// your LAN could advertise that service and harvest it. Pinning the phone's IP
// here is the way to opt out of trusting the network. It is also the fix for
// routers that block multicast, where mDNS never works anyway.
//
// Leave as "" to rely on mDNS discovery.
#define POMO_HOST_FALLBACK ""
#define POMO_PORT_FALLBACK 9876
