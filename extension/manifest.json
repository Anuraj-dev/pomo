{
  "manifest_version": 3,
  "name": "Pomo",
  "version": "0.1.14",
  "description": "A focus instrument: pomodoro timer, history, and stats. Pair with the phone over LAN; Crew lives on the phone.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "sw.js"
  },
  "action": {
    "default_title": "Pomo",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "permissions": ["alarms", "notifications", "storage", "sidePanel", "tabs"],
  "optional_host_permissions": ["http://*/*", "http://*:*/*"]
}
